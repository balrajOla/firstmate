{
  "name": "@balrajola/olympus-pi",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Pi terminal command view for the Olympus durable coordinator",
  "pi": {
    "extensions": [
      "index.ts"
    ]
